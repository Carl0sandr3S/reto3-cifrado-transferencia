# Copie a .env (ignorado por git) y complete. Ninguno de estos valores es un secreto:
# los secretos viven en Cloud KMS, no en variables de entorno.

# --- Proyecto GCP (deploy/gcp.py) ---
PROJECT_ID=mi-proyecto-gcp
REGION=us-east1

# --- Aplicación (securetransfer) ---
SECXFER_KEY_PROVIDER=kms
SECXFER_KMS_KEY=projects/mi-proyecto-gcp/locations/us-east1/keyRings/securetransfer-ring/cryptoKeys/transfer-kek
SECXFER_LOG_FORMAT=json
SECXFER_LOG_LEVEL=INFO
# SECXFER_CHUNK_SIZE=1048576

# Solo desarrollo local con --key-provider local (genere una con: python -m securetransfer gen-local-key)
# SECXFER_LOCAL_KEY=
